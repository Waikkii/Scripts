
#!name=eBay 全球代理分流
#!desc=eBay 全球站点及相关服务代理分流，支持自定义节点或策略组，无节点检测。
#!author=Custom
#!arguments=代理分流:PROXY
#!arguments-desc=填写代理节点或策略组名称，默认 PROXY。
#!category=应用分流🔀

[Rule]
# eBay Global
DOMAIN-SUFFIX,ebay.at,{{{代理分流}}}
